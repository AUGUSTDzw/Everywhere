<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="using:Everywhere.Views">
  <ControlTheme
    x:Key="{x:Type v:AssistantConfiguratorSelector}"
    TargetType="v:AssistantConfiguratorSelector">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel VerticalSpacing="8">
          <!--  ReSharper disable once Xaml.StaticResourceNotResolved  -->
          <ListBox
            DockPanel.Dock="Top"
            Background="{DynamicResource LightCardBackgroundColor}"
            CornerRadius="{DynamicResource 3XlCornerRadius}"
            ItemsSource="{Binding ConfiguratorModels, RelativeSource={RelativeSource TemplatedParent}}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedConfiguratorModel, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid
                  ColumnSpacing="4" Rows="1"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerTheme>
              <ControlTheme
                BasedOn="{StaticResource TabListBoxItemTheme}"
                TargetType="ListBoxItem">
                <Setter Property="Padding" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="20"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>

            <ListBox.DataTemplates>
              <DataTemplate DataType="v:AssistantConfiguratorSelector+OfficialConfiguratorModel">
                <Panel>
                  <shadui:SmoothBorder
                    Margin="-13" CornerRadius="20">
                    <shadui:SmoothBorder.Background>
                      <ConicGradientBrush Center="0%,-50%">
                        <GradientStop Offset="0.25" Color="#AA4EADFC"/>
                        <GradientStop Offset="0.35" Color="#AAEE4BB5"/>
                        <GradientStop Offset="0.48" Color="#AADFDF62"/>
                      </ConicGradientBrush>
                    </shadui:SmoothBorder.Background>

                    <shadui:SmoothBorder.OpacityMask>
                      <!--  <DrawingBrush  -->
                      <!--  Stretch="Fill" Transform="scale(1, 0.6)">  -->
                      <!--   <DrawingBrush.Drawing> -->
                      <!--     <DrawingGroup ClipGeometry="M0,0 V256 H1009 V0 H0 Z"> -->
                      <!--       <GeometryDrawing Geometry="F1 M1009,256z M0,0z M0,0C46,183 149,88 302,63 409,48 556,265 769,256 860,252 1006,209 1006,209L1008,0 0,0z"> -->
                      <!--         <GeometryDrawing.Brush> -->
                      <!--           <LinearGradientBrush SpreadMethod="Pad" StartPoint="469,253" EndPoint="539,-47"> -->
                      <!--             <GradientStop Offset="0" Color="#FFFFFFFF"/> -->
                      <!--             <GradientStop Offset="1" Color="#FF000000"/> -->
                      <!--           </LinearGradientBrush> -->
                      <!--         </GeometryDrawing.Brush> -->
                      <!--       </GeometryDrawing> -->
                      <!--     </DrawingGroup> -->
                      <!--   </DrawingBrush.Drawing> -->
                      <!-- </DrawingBrush> -->
                      <RadialGradientBrush Center="20%,0%" GradientOrigin="20%,0%" RadiusX="70%" RadiusY="50%">
                        <GradientStop Offset="0.0" Color="#FFFFFFFF"/>
                        <GradientStop Offset="1.0" Color="#00FFFFFF"/>
                      </RadialGradientBrush>
                    </shadui:SmoothBorder.OpacityMask>
                  </shadui:SmoothBorder>

                  <StackPanel
                    Orientation="Vertical" Spacing="4">
                    <TextBlock
                      Text="{Binding HeaderKey^}"
                      TextWrapping="Wrap"/>
                    <TextBlock
                      Classes="Muted Caption"
                      Text="{Binding DescriptionKey^}"
                      TextWrapping="Wrap"/>
                  </StackPanel>
                </Panel>
              </DataTemplate>

              <DataTemplate DataType="v:AssistantConfiguratorSelector+ConfiguratorModel">
                <StackPanel
                  Orientation="Vertical" Spacing="4">
                  <TextBlock
                    Text="{Binding HeaderKey^}"
                    TextWrapping="Wrap"/>
                  <TextBlock
                    Classes="Muted Caption"
                    Text="{Binding DescriptionKey^}"
                    TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>

          <ScrollViewer
            Margin="0,0,-12,0" HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <v:SettingsItemsControl
              Margin="0,0,12,0"
              IsVisible="{TemplateBinding IsSettingsVisible}"
              ItemsSource="{Binding Assistant?.Configuration.SettingsItems, RelativeSource={RelativeSource TemplatedParent}}"/>
          </ScrollViewer>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>